# Copy this file to `.env` and fill in your keys. Never commit the real .env.
# A variable already set in your shell always wins over this file.

# Required: pay-as-you-go Anthropic API credits.
# NOTE: a Claude Pro subscription does NOT cover this - separate billing.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended: free, no billing. Without it Google Books returns
# HTTP 429 and the match rate looks far worse than it is.
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Optional: shared book cache. Without these the pipeline still runs, it just
# queries Open Library / Google Books every time.
# Project URL is public; the service key is a SECRET - never commit it.
# Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://ithkjmsrtakkcdygfwgh.supabase.co
SUPABASE_SERVICE_KEY=
